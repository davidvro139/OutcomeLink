# Settings for docker-compose.yml. Copy to `.env` (which is git-ignored) and fill in.

# Required. Long random values — e.g. `openssl rand -base64 48`. Keep them out of version control and back
# them up: changing SECRETS_ENCRYPTION_KEY makes stored connection secrets unreadable, and changing the JWT
# secrets signs everyone out.
# (The MySQL password goes into a connection URL, so avoid the characters @ : / ? # % in it.)
MYSQL_ROOT_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SECRETS_ENCRYPTION_KEY=

# Where users reach the app (used for CORS and for links in emails). Use the https:// address once TLS is in place.
PUBLIC_URL=http://localhost:8080
# Host port for the web app.
WEB_PORT=8080

# Email (optional — leave SMTP_HOST and MAIL_FROM empty and invitations/surveys show a link to copy instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
