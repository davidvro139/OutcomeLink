{
  "name": "@outcomelink/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('node_modules/.vite', { recursive: true, force: true })\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "cypress:open": "node scripts/run-cypress.cjs open",
    "e2e": "node scripts/run-cypress.cjs run"
  },
  "dependencies": {
    "@mantine/charts": "^7.15.1",
    "@mantine/core": "^7.15.1",
    "@mantine/dates": "^7.15.1",
    "@mantine/form": "^7.15.1",
    "@mantine/hooks": "^7.15.1",
    "@mantine/notifications": "^7.15.1",
    "@outcomelink/shared": "*",
    "@tabler/icons-react": "^3.24.0",
    "@tanstack/react-query": "^5.62.7",
    "dayjs": "^1.11.13",
    "leaflet": "^1.9.4",
    "mantine-form-zod-resolver": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.13.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^15.21.1",
    "jsdom": "^25.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
