NODE_ENV=development
PORT=4000

DATABASE_URL="mysql://user:password@localhost:3306/outcomelink"

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CLIENT_ORIGIN=http://localhost:5173

SECRETS_ENCRYPTION_KEY=change-me-secrets-encryption-key

# Email delivery (optional). Set SMTP_HOST and MAIL_FROM to turn it on; leave
# them unset and invitations/surveys fall back to copy-a-link.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="OutcomeLink <no-reply@example.edu>"
# PUBLIC_APP_URL=https://outcomelink.example.edu   # base for links in emails; defaults to CLIENT_ORIGIN

# Number of reverse proxies in front of the API (0 = reached directly). Rate limiting keys on the client address.
# TRUST_PROXY=0
