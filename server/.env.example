NODE_ENV=development
PORT=4000

DATABASE_URL="mysql://user:password@localhost:3306/outcomelink"

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CLIENT_ORIGIN=http://localhost:5173

SECRETS_ENCRYPTION_KEY=change-me-secrets-encryption-key

# Development placeholder so Settings → Backups can show the seeded check-in.
# Replace it before any deployment. Leave it unset and the check-in endpoint stays hidden.
BACKUP_CHECKIN_TOKEN=dev-backup-checkin-token
