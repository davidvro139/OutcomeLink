NODE_ENV=test
PORT=4001

# A separate, disposable database — jest.globalSetup.cjs runs `prisma migrate
# reset --force` against this on every `npm run test:integration`, so it must
# never point at the same database as .env.
DATABASE_URL="mysql://user:password@localhost:3306/outcomelink_test"

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CLIENT_ORIGIN=http://localhost:5173

SECRETS_ENCRYPTION_KEY=test-secrets-encryption-key

# Email delivery (optional). Set SMTP_HOST and MAIL_FROM to turn it on; leave
# them unset and invitations/surveys fall back to copy-a-link.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="OutcomeLink <no-reply@example.edu>"
# PUBLIC_APP_URL=https://outcomelink.example.edu   # base for links in emails; defaults to CLIENT_ORIGIN
