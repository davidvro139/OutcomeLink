NODE_ENV=test
PORT=4001

# A separate, disposable database — jest.globalSetup.cjs runs `prisma migrate
# reset --force` against this on every `npm run test:integration`, so it must
# never point at the same database as .env.
DATABASE_URL="mysql://user:password@localhost:3306/outcomelink_test"

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CLIENT_ORIGIN=http://localhost:5173
