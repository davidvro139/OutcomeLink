// OutcomeLink database schema — translated from docs/DATA_MODEL.md.
// Field-level FK relationships only exist here where the data model doc marked
// them "(FK -> X)"; "by"-style attribution fields (verified_by, uploaded_by,
// performed_by, resolved_by, finalized_by, reopened_by) were deliberately left
// as plain strings in that doc and are kept that way here for fidelity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
