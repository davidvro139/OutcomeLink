// ---------------------------------------------------------------------------
// 11. Operations
// ---------------------------------------------------------------------------

model ImportBatch {
  id               Int               @id @default(autoincrement())
  institutionId    Int               @map("institution_id")
  sourceSystem     String            @map("source_system")
  originalFilename String?           @map("original_filename")
  // Reference into the storage adapter (server/src/lib/storage.ts), not the raw
  // bytes — the file is re-read and re-parsed at each wizard step (map/validate/
  // preview/commit) rather than persisting parsed rows in the database.
  fileReference String @map("file_reference")
  // The mapping actually applied to this batch (source CSV column -> target
  // Student field). Independent of mappingProfileId below: a batch can use an
  // ad hoc mapping never saved as a reusable profile, or start from a saved
  // profile and still diverge from it for this one run.
  columnMapping    Json?             @map("column_mapping")
  totalRows        Int?              @map("total_rows")
  importedRowCount Int?              @map("imported_row_count")
  // Set only when this batch's mapping includes an enrollment field (see
  // shared/src/imports.ts) — null for a plain student-roster import, which
  // never creates enrollments at all.
  importedEnrollmentCount Int?       @map("imported_enrollment_count")
  uploadedBy       String            @map("uploaded_by")
  uploadedAt       DateTime          @default(now()) @map("uploaded_at")
  mappingProfileId Int?              @map("mapping_profile_id")
  status           ImportBatchStatus @default(UPLOADED)
  // Set only when this batch's rows were fetched live from a DataSourceConnection
  // (e.g. OneWorld/Dataverse) rather than uploaded as a file — everything past
  // that point (fileReference, mapping, validate, preview, commit) is identical
  // either way, since the fetched rows are serialized to the same CSV shape and
  // saved through the same storage adapter.
  dataSourceConnectionId Int?        @map("data_source_connection_id")

  institution           Institution            @relation(fields: [institutionId], references: [id])
  mappingProfile        ImportMappingProfile?  @relation(fields: [mappingProfileId], references: [id])
  dataSourceConnection  DataSourceConnection?  @relation(fields: [dataSourceConnectionId], references: [id])
  rowErrors             ImportRowError[]

  @@map("import_batches")
}

model ImportMappingProfile {
  id               Int    @id @default(autoincrement())
  institutionId    Int    @map("institution_id")
  sourceSystemName String @map("source_system_name")
  columnMapping    Json   @map("column_mapping")

  institution   Institution   @relation(fields: [institutionId], references: [id])
  importBatches ImportBatch[]

  @@unique([institutionId, sourceSystemName])
  @@map("import_mapping_profiles")
}

// A live external data source an institution's Bulk Import can pull from
// instead of a manually uploaded file — currently scoped to Microsoft
// Dataverse/Power Platform systems (e.g. OneWorld SIS, which is built on
// Dynamics 365), reached via Dataverse's standard OData Web API using an
// Azure AD (Entra ID) app registration's client-credentials OAuth2 flow.
// `type` exists to leave room for a different connector kind later without a
// schema change, but only "DATAVERSE_ODATA" is actually implemented.
//
// Deliberately one connection = one Dataverse table (`entityLogicalName`):
// an institution wanting both, say, a Student table and a separate
// Enrollment table from the same OneWorld environment creates two
// connections and runs two import batches, the same way two separate CSV
// exports would be handled — this avoids a cross-table join/expand design
// that Dataverse doesn't make trivial anyway and whose real shape depends on
// schema this app has no way to know in advance.
//
// clientSecret is encrypted at rest (server/src/lib/secrets.ts) and never
// returned by any API response — only ever decrypted in-process, immediately
// before an outbound token request.
model DataSourceConnection {
  id                     Int      @id @default(autoincrement())
  institutionId          Int      @map("institution_id")
  name                   String
  type                   String   @default("DATAVERSE_ODATA")
  environmentUrl         String   @map("environment_url")
  tenantId               String   @map("tenant_id")
  clientId               String   @map("client_id")
  clientSecretEncrypted  String   @map("client_secret_encrypted") @db.Text
  entityLogicalName      String   @map("entity_logical_name")
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  lastTestedAt           DateTime? @map("last_tested_at")
  lastTestStatus         String?  @map("last_test_status")
  lastTestError          String?  @map("last_test_error") @db.Text

  institution   Institution   @relation(fields: [institutionId], references: [id])
  importBatches ImportBatch[]

  @@unique([institutionId, name])
  @@map("data_source_connections")
}

model ImportRowError {
  id            Int    @id @default(autoincrement())
  importBatchId Int    @map("import_batch_id")
  rowNumber     Int    @map("row_number")
  errorMessage  String @map("error_message") @db.Text
  rawRowData    Json   @map("raw_row_data")

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])

  @@map("import_row_errors")
}

model Notification {
  id                  Int              @id @default(autoincrement())
  userId              Int              @map("user_id")
  type                NotificationType
  // Human-readable body — the schema originally had no way to say anything
  // beyond a type + entity reference, but a digest is a summary/count, not a
  // pointer to one record, so there's nothing else to derive display text
  // from. Same reasoning as CommunicationEvent.summaryText.
  message             String           @db.Text
  referenceEntityType String?          @map("reference_entity_type")
  referenceEntityId   Int?             @map("reference_entity_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  readAt              DateTime?        @map("read_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

/// Custom Report Builder (Phase 3, spec §64). `definition` holds a
/// ReportDefinition (shared/src/reportBuilder.ts) — entity type, selected
/// fields, filters, optional reporting period — validated against the
/// current field/filter registry at run time rather than at save time, so a
/// saved report never gets "frozen" against a registry change; it just
/// re-validates (and could surface an error) the next time it's run.
/// Institution-wide, not just visible to its creator — reports are usually
/// meant to be shared with colleagues, same reasoning as ImportMappingProfile.
model SavedReport {
  id            Int      @id @default(autoincrement())
  institutionId Int      @map("institution_id")
  createdBy     Int      @map("created_by")
  name          String
  definition    Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  creator     User        @relation(fields: [createdBy], references: [id])

  scheduledReportSubscriptions ScheduledReportSubscription[]

  @@unique([institutionId, name])
  @@map("saved_reports")
}

enum ScheduledReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// One of two mutually-exclusive report sources a subscription can point at
// (docs/TODO.md's Scheduled Reports entry has the full "why both" reasoning):
// a SavedReport's Custom Report Builder definition (re-run as-is via
// customReportBuilder.ts's buildCustomReportSheet), or one of a small, fixed
// set of built-in dashboards spec §50 names by example, none of which have a
// "saved definition" concept of their own. Exactly one of
// savedReportId/builtInReportType is set on a given row, enforced at the Zod
// layer (scheduledReports.ts) rather than a DB constraint — the same
// either/or-by-convention pattern AllowableSubtractionReason (only
// meaningful when WITHDRAWN) already uses in this schema.
enum ScheduledReportSource {
  SAVED_REPORT
  BUILT_IN
}

// The 4 built-in report types spec §50 names by example (Monthly Outcomes
// Summary, Weekly Missing Verification Report, Quarterly Employer Report,
// Annual CPL Readiness Report), mapped onto the closest already-existing
// report each name describes rather than inventing 4 new report shapes:
// OUTCOME_FUNNEL (P8) for "Outcomes Summary" (data-completeness through the
// pipeline), UNKNOWN_OUTCOMES (P8) for "Missing Verification" (exactly the
// population that still needs chasing down), EMPLOYER_ANALYTICS (P5) for
// "Employer Report", and CPL_READINESS (P2) for "CPL Readiness."
enum BuiltInReportType {
  OUTCOME_FUNNEL
  UNKNOWN_OUTCOMES
  EMPLOYER_ANALYTICS
  CPL_READINESS
}

// A recurring subscription that automatically re-runs one report and
// delivers it as a Notification with a downloadable workbook — see
// docs/TODO.md's Scheduled Reports entry for the full design (no email
// infrastructure exists anywhere in this app, so "delivery" means an in-app
// notification + generated file, the same honest scope boundary the
// missing-outcomes digest and graduate outreach campaign already document).
model ScheduledReportSubscription {
  id                Int                      @id @default(autoincrement())
  institutionId     Int                      @map("institution_id")
  name              String
  frequency         ScheduledReportFrequency
  reportSource      ScheduledReportSource    @map("report_source")
  savedReportId     Int?                     @map("saved_report_id")
  builtInReportType BuiltInReportType?       @map("built_in_report_type")
  // For a BUILT_IN report that needs one (all but EMPLOYER_ANALYTICS, which
  // runs institution-wide/all-time when omitted, matching its own existing
  // endpoint's behavior): null means "resolve to the institution's most
  // recently created reporting period at run time" rather than a period
  // fixed forever at subscribe time, so a recurring subscription keeps
  // reporting on whatever's current instead of the same period every run.
  reportingPeriodId Int?                     @map("reporting_period_id")
  active            Boolean                  @default(true)
  createdBy         Int                      @map("created_by")
  createdAt         DateTime                 @default(now()) @map("created_at")
  lastRunAt         DateTime?                @map("last_run_at")
  nextRunAt         DateTime                 @map("next_run_at")

  institution     Institution          @relation(fields: [institutionId], references: [id])
  savedReport     SavedReport?         @relation(fields: [savedReportId], references: [id])
  reportingPeriod ReportingPeriod?     @relation(fields: [reportingPeriodId], references: [id])
  creator         User                 @relation(fields: [createdBy], references: [id])
  runs            ScheduledReportRun[]

  @@unique([institutionId, name])
  @@map("scheduled_report_subscriptions")
}

model ScheduledReportRun {
  id             Int      @id @default(autoincrement())
  subscriptionId Int      @map("subscription_id")
  runAt          DateTime @default(now()) @map("run_at")
  status         String
  errorMessage   String?  @map("error_message") @db.Text
  fileReference  String?  @map("file_reference")
  rowCount       Int?     @map("row_count")

  subscription ScheduledReportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("scheduled_report_runs")
}
