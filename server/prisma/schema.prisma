model Department {
  id            Int    @id @default(autoincrement())
  institutionId Int    @map("institution_id")
  name          String

  institution Institution @relation(fields: [institutionId], references: [id])
  programs    Program[]

  @@map("departments")
}

model Program {
  id                           Int       @id @default(autoincrement())
  institutionId                Int       @map("institution_id")
  campusId                     Int       @map("campus_id")
  departmentId                 Int?      @map("department_id")
  name                         String
  code                         String
  cipCode                      String?   @map("cip_code")
  credentialType               String    @map("credential_type")
  programLength                String?   @map("program_length")
  clockHours                   Int?      @map("clock_hours")
  creditHours                  Int?      @map("credit_hours")
  licensureRequired            Boolean   @default(false) @map("licensure_required")
  accreditationReportingStatus String?   @map("accreditation_reporting_status")
  active                       Boolean   @default(true)
  effectiveStartDate           DateTime? @map("effective_start_date")
  effectiveEndDate             DateTime? @map("effective_end_date")

  institution Institution @relation(fields: [institutionId], references: [id])
  campus      Campus      @relation(fields: [campusId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])

  cohorts               Cohort[]
  enrollments           StudentEnrollment[]
  licensureResults      LicensureResult[]
  cplCalculationResults CplCalculationResult[]
  validationIssues      ValidationIssue[]
  improvementPlans      ImprovementPlan[]
  userAccess            UserProgramAccess[]
  negotiatedBenchmarks  NegotiatedBenchmark[]
  followUpOwner         ProgramFollowUpOwner?

  @@map("programs")
}

/// Advanced Workflow Automation (Phase 3, docs/TODO.md): the single staff
/// member auto-assignment should hand new follow-up work to for this
/// program. Optional and admin-managed — a program with no row here just
/// means auto-assignment skips it, same as a student with no assignment at
/// all today. Distinct from UserProgramAccess (who may *see* this program's
/// data) — this is specifically "who owns chasing it down."
model ProgramFollowUpOwner {
  id            Int      @id @default(autoincrement())
  institutionId Int      @map("institution_id")
  programId     Int      @unique @map("program_id")
  staffUserId   Int      @map("staff_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  program     Program     @relation(fields: [programId], references: [id])
  staffUser   User        @relation(fields: [staffUserId], references: [id])

  @@map("program_follow_up_owners")
}

/// A Commission-approved alternate benchmark for one program+metric, per
/// docs/COE_RULE_MATRIX.md's negotiated-rate note — e.g. a court reporting
/// program's completion rate. Distinct from RuleSet.rule_definition's
/// institution-wide standard benchmarks; this overrides them for exactly the
/// program+metric+date range specified, with a required record of the
/// Commission's approval. See server/src/modules/accreditation/benchmarks
/// for where this is applied.
model NegotiatedBenchmark {
  id                 Int       @id @default(autoincrement())
  programId          Int       @map("program_id")
  metric             CplMetric
  approvedPercentage Decimal   @db.Decimal(5, 2) @map("approved_percentage")
  effectiveStartDate DateTime  @map("effective_start_date")
  effectiveEndDate   DateTime? @map("effective_end_date")
  approvalReference  String    @db.Text @map("approval_reference")
  createdBy          String    @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")

  program Program @relation(fields: [programId], references: [id])

  @@map("negotiated_benchmarks")
}

model Cohort {
  id        Int     @id @default(autoincrement())
  programId Int     @map("program_id")
  name      String
  entryTerm String? @map("entry_term")
  entryYear Int?    @map("entry_year")

  program     Program             @relation(fields: [programId], references: [id])
  enrollments StudentEnrollment[]

  @@map("cohorts")
}

