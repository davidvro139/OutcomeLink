  @@map("user_program_access")
}

model UserCampusAccess {
  id       Int @id @default(autoincrement())
  userId   Int @map("user_id")
  campusId Int @map("campus_id")

  user   User   @relation(fields: [userId], references: [id])
  campus Campus @relation(fields: [campusId], references: [id])

  @@unique([userId, campusId])
  @@map("user_campus_access")
}

// ---------------------------------------------------------------------------
// 4. Students
// ---------------------------------------------------------------------------

model Student {
  id                Int      @id @default(autoincrement())
  institutionId     Int      @map("institution_id")
  internalStudentId String   @map("internal_student_id")
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  preferredName     String?  @map("preferred_name")
  email             String?
  phone             String?
  createdAt         DateTime @default(now()) @map("created_at")
  // The first *real* follow-up ownership field in the schema (Advanced
  // Workflow Automation, Phase 3, docs/TODO.md) — distinct from
  // FollowUpAttempt.staffUserId, which only records who logged one past
  // attempt. Nullable: unassigned is the correct default until an admin
  // configures auto-assignment or a staff member assigns by hand.
  assignedStaffUserId Int?   @map("assigned_staff_user_id")

  institution             Institution                     @relation(fields: [institutionId], references: [id])
  assignedStaffUser       User?                           @relation("StudentFollowUpAssignment", fields: [assignedStaffUserId], references: [id])
  communicationPreference StudentCommunicationPreference?
  demographics            StudentDemographics?
  enrollments             StudentEnrollment[]
  employmentRecords       EmploymentRecord[]
  licensureResults        LicensureResult[]
  followUpAttempts        FollowUpAttempt[]
  communicationEvents     CommunicationEvent[]
  graduateSurveys         GraduateSurvey[]
  employerSurveys         EmployerSurvey[]
  validationIssues        ValidationIssue[]

  mergesAsSurvivor StudentMergeLog[] @relation("SurvivingStudent")
  mergesAsMerged   StudentMergeLog[] @relation("MergedStudent")

  // Per-institution identifier uniqueness. Duplicate *people* entered under
  // different internal_student_id values are still caught by the
  // ValidationIssue "duplicate student" check and resolved via
  // StudentMergeLog — this only rejects literal ID collisions.
  @@unique([institutionId, internalStudentId])
  @@map("students")
}

model StudentCommunicationPreference {
  id                     Int             @id @default(autoincrement())
  studentId              Int             @unique @map("student_id")
  preferredContactMethod FollowUpMethod? @map("preferred_contact_method")
  smsConsentStatus       Boolean?        @map("sms_consent_status")
  smsConsentDate         DateTime?       @map("sms_consent_date")
  doNotContact           Boolean         @default(false) @map("do_not_contact")
  doNotContactReason     String?         @map("do_not_contact_reason") @db.Text

  student Student @relation(fields: [studentId], references: [id])

  @@map("student_communication_preferences")
}

model StudentDemographics {
  id                       Int     @id @default(autoincrement())
  studentId                Int     @unique @map("student_id")
  gender                   String? @map("gender")
  raceEthnicity            String? @map("race_ethnicity")
  economicallyDisadvantaged Boolean? @map("economically_disadvantaged")
  firstGenerationStudent   Boolean? @map("first_generation_student")
  disabilityStatus         Boolean? @map("disability_status")

  student Student @relation(fields: [studentId], references: [id])

  @@map("student_demographics")
}

model StudentEnrollment {
  id                     Int              @id @default(autoincrement())
  studentId              Int              @map("student_id")
  programId              Int              @map("program_id")
  campusId               Int              @map("campus_id")
  cohortId               Int?             @map("cohort_id")
  startDate              DateTime         @map("start_date")
  expectedCompletionDate DateTime?        @map("expected_completion_date")
  actualCompletionDate   DateTime?        @map("actual_completion_date")
  enrollmentStatus       EnrollmentStatus @map("enrollment_status")
  credentialEarned       String?          @map("credential_earned")
  exitReason             String?          @map("exit_reason")
  // Only meaningful when enrollmentStatus is WITHDRAWN — see the enum's own doc comment.
  allowableSubtractionReason AllowableSubtractionReason? @map("allowable_subtraction_reason")
  // Free-text, institution/SIS-defined label (e.g. "Certificate Seeker",
  // "Occupational Upgrade", "Secondary") — descriptive only, not a controlled
  // vocabulary, since COE doesn't mandate specific category names here (per
  // docs/TODO.md §9 investigation). What actually gates the classifier is
  // reportableForAccreditation below.
  enrollmentObjective        String?                      @map("enrollment_objective")
  // Whether this enrollment is in scope for CPL reporting at all — e.g. false
  // for a secondary/dual-enrolled high-school student or one enrolled purely
  // for personal enrichment. Defaults true since most enrollments are reportable.
  reportableForAccreditation Boolean                      @default(true) @map("reportable_for_accreditation")

  student Student @relation(fields: [studentId], references: [id])
  program Program @relation(fields: [programId], references: [id])
  campus  Campus  @relation(fields: [campusId], references: [id])
  cohort  Cohort? @relation(fields: [cohortId], references: [id])

  outcomeRecords  StudentOutcomeRecord[]
  classifications StudentClassification[]

  @@map("student_enrollments")
}

// ---------------------------------------------------------------------------
// 5. Accreditation engine
// ---------------------------------------------------------------------------

model AccreditationFramework {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text

  ruleSets RuleSet[]

  @@map("accreditation_frameworks")
}

model RuleSet {
  id                          Int       @id @default(autoincrement())
  frameworkId                 Int       @map("framework_id")
  versionLabel                String    @map("version_label")
  effectiveStartDate          DateTime  @map("effective_start_date")
  effectiveEndDate            DateTime? @map("effective_end_date")
  // Deliberately unresolved until official COE documentation is reviewed —
  // see docs/DATA_MODEL.md §13 and spec §67. Do not design this shape from
  // assumptions.
  ruleDefinitionSchemaVersion String?   @map("rule_definition_schema_version")
  ruleDefinition              Json      @map("rule_definition")

  framework AccreditationFramework @relation(fields: [frameworkId], references: [id])

  reportingPeriods          ReportingPeriod[]
  classificationsDetermined StudentClassification[]

  @@unique([frameworkId, versionLabel])
  @@map("rule_sets")
}

model ReportingPeriod {
  id                     Int                   @id @default(autoincrement())
  institutionId          Int                   @map("institution_id")
  ruleSetId              Int                   @map("rule_set_id")
  label                  String
  startDate              DateTime              @map("start_date")
  endDate                DateTime              @map("end_date")
  // Distinct from endDate: the training-material-documented "outcomes due
  // Dec 1, annual report due first week of December" deadline for having
  // outcome data collected, separate from when the period itself ends.
  // Deferred item from docs/TODO.md, not part of the original Phase 2 plan.
  outcomesDeadline       DateTime?             @map("outcomes_deadline")
  cohortWindowDefinition Json?                 @map("cohort_window_definition")
  status                 ReportingPeriodStatus @default(OPEN)
  finalizedAt            DateTime?             @map("finalized_at")
  finalizedBy            String?               @map("finalized_by")
  reopenedAt             DateTime?             @map("reopened_at")
  reopenedBy             String?               @map("reopened_by")
  reopenReason           String?               @map("reopen_reason") @db.Text
  // Close-out checklist (docs/TODO.md): when validation last ran (stamped without an
  // audit entry — it changes on every run), and the reviewer's sign-off, which
  // vouches for one particular computed-at and goes stale if results or data
  // change afterwards. finalizeOverrideReason is why finalize went ahead with
  // blockers outstanding. Sign-off, override and reopen are audited as period
  // field changes like the rest of the lifecycle.
  validatedAt            DateTime?             @map("validated_at")
  signedOffAt            DateTime?             @map("signed_off_at")
  signedOffBy            String?               @map("signed_off_by")
  signedOffNote          String?               @map("signed_off_note") @db.Text
  signedOffResultsAt     DateTime?             @map("signed_off_results_at")
  finalizeOverrideReason String?               @map("finalize_override_reason") @db.Text

  institution Institution @relation(fields: [institutionId], references: [id])
  ruleSet     RuleSet     @relation(fields: [ruleSetId], references: [id])

  studentClassifications StudentClassification[]
  cplCalculationResults  CplCalculationResult[]
  validationIssues       ValidationIssue[]
  outcomeRecords         StudentOutcomeRecord[]
  improvementPlans       ImprovementPlan[]
  scheduledReportSubscriptions ScheduledReportSubscription[]

  @@unique([institutionId, label])
  @@map("reporting_periods")
}

model StudentClassification {
  id                    Int       @id @default(autoincrement())
  studentEnrollmentId   Int       @map("student_enrollment_id")
  reportingPeriodId     Int       @map("reporting_period_id")
  // A student is classified separately per metric — see docs/DATA_MODEL.md §13.
  metric                CplMetric
  classificationCode    String    @map("classification_code")
  determinedByRuleSetId Int       @map("determined_by_rule_set_id")
  computedAt            DateTime  @default(now()) @map("computed_at")

  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])
  reportingPeriod     ReportingPeriod   @relation(fields: [reportingPeriodId], references: [id])
  determinedByRuleSet RuleSet           @relation(fields: [determinedByRuleSetId], references: [id])

  explanation CplCalculationExplanation?

  @@unique([studentEnrollmentId, reportingPeriodId, metric])
  @@map("student_classifications")
}

model CplCalculationResult {
  id                Int       @id @default(autoincrement())
  programId         Int?      @map("program_id")
  reportingPeriodId Int       @map("reporting_period_id")
  metric            CplMetric
  numerator         Int
  denominator       Int
  percentage        Decimal   @db.Decimal(5, 2)
  computedAt        DateTime  @default(now()) @map("computed_at")

  program         Program?        @relation(fields: [programId], references: [id])
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])

  @@unique([programId, reportingPeriodId, metric])
  @@map("cpl_calculation_results")
}

model CplCalculationExplanation {
  id                      Int     @id @default(autoincrement())
  studentClassificationId Int     @unique @map("student_classification_id")
  countsInNumerator       Boolean @map("counts_in_numerator")
  countsInDenominator     Boolean @map("counts_in_denominator")
  reasonText              String  @map("reason_text") @db.Text

  studentClassification StudentClassification @relation(fields: [studentClassificationId], references: [id])

  @@map("cpl_calculation_explanations")
}

model ValidationIssue {
  id                Int                @id @default(autoincrement())
  reportingPeriodId Int                @map("reporting_period_id")
  studentId         Int?               @map("student_id")
  programId         Int?               @map("program_id")
  issueType         String             @map("issue_type")
  severity          ValidationSeverity
  detectedAt        DateTime           @default(now()) @map("detected_at")
  resolvedAt        DateTime?          @map("resolved_at")
  resolvedBy        String?            @map("resolved_by")

  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id])
  student         Student?        @relation(fields: [studentId], references: [id])
  program         Program?        @relation(fields: [programId], references: [id])

  @@map("validation_issues")
}

// ---------------------------------------------------------------------------
// 6. Outcomes
// ---------------------------------------------------------------------------

model StudentOutcomeRecord {
  id                              Int       @id @default(autoincrement())
  studentEnrollmentId             Int       @map("student_enrollment_id")
  reportingPeriodId               Int       @map("reporting_period_id")
  completionClassification        String?   @map("completion_classification")
  employmentStatus                String?   @map("employment_status")
  employerId                      Int?      @map("employer_id")
  jobTitle                        String?   @map("job_title")
  employmentStartDate             DateTime? @map("employment_start_date")
  relatedToTraining               Boolean?  @map("related_to_training")
  relatedToTrainingJustification  String?   @map("related_to_training_justification") @db.Text
  // "STUDENT_REPORTED" | "INSTRUCTOR_REPORTED" — see shared/src/outcomes.ts's
  // RELATED_TO_TRAINING_SOURCES. Plain string like the other outcome-record
  // vocab fields, validated at the Zod layer.
  relatedToTrainingSource          String?   @map("related_to_training_source")
  continuingEducationStatus       String?   @map("continuing_education_status")
  militaryStatus                  String?   @map("military_status")
  availabilityForEmploymentStatus String?   @map("availability_for_employment_status")
  licensureRequired               Boolean   @default(false) @map("licensure_required")
  verificationStatus              String?   @map("verification_status")
  verificationMethod              String?   @map("verification_method")
  verifiedBy                      String?   @map("verified_by")
  verificationDate                DateTime? @map("verification_date")
  notes                           String?   @db.Text

  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])
  reportingPeriod   ReportingPeriod   @relation(fields: [reportingPeriodId], references: [id])
  employer          Employer?         @relation(fields: [employerId], references: [id])

  evidence            Evidence[]
  verificationRecords VerificationRecord[]

  @@map("student_outcome_records")
}

model EmploymentRecord {
  id                              Int       @id @default(autoincrement())
  studentId                       Int       @map("student_id")
  employerId                      Int       @map("employer_id")
  jobTitle                        String    @map("job_title")
  startDate                       DateTime  @map("start_date")
