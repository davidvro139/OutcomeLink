/// Split by survey type (not a single SURVEY_SENT/SURVEY_RESPONSE pair) because
/// sourceId alone can't disambiguate which table it points into — GraduateSurvey
/// and EmployerSurvey (and their Response tables) are separate auto-incrementing
/// primary keys, so id 42 could exist in either. Phase 2 P13 (docs/TODO.md).
enum CommunicationEventType {
  FOLLOW_UP_ATTEMPT
  GRADUATE_SURVEY_SENT
  GRADUATE_SURVEY_RESPONSE
  EMPLOYER_SURVEY_SENT
  EMPLOYER_SURVEY_RESPONSE
  VERIFICATION_CONTACT
  NOTIFICATION
}

/// COE's enrollment-stage "Allowable Subtraction" categories that apply to a
/// WITHDRAWN enrollment — see shared/src/enrollment.ts for the full rationale
/// and docs/COE_RULE_MATRIX.md §2 for the source. Meaningful only when
/// enrollmentStatus is WITHDRAWN.
enum AllowableSubtractionReason {
  FULL_REFUND_OR_FIRST_DAY_ONLY
  DOCUMENTED_UNAVAILABLE
  MISSION_FOREIGN_AID_OR_MILITARY_ACTIVATION
}

