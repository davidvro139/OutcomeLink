enum ReportExportJobStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Report pagination and bounded exports (docs/TODO.md): an on-demand Custom
/// Report Builder export whose totalCount crossed the synchronous-export
/// threshold. Generated fire-and-forget outside the request that created it
/// (this app's first genuinely async, non-cron background unit of work —
/// Scheduled Reports' "Run Now" is still a synchronous await, just outside
/// the subscription's *original* creating request). No message queue exists
/// here, so a job stuck PENDING across a server restart stays PENDING
/// forever — an accepted, documented limitation at this app's scale, the
/// same honesty every other "no job-scheduler infrastructure" note in this
/// schema already carries.
model ReportExportJob {
  id            Int                   @id @default(autoincrement())
  institutionId Int                   @map("institution_id")
  requestedBy   Int                   @map("requested_by")
  definition    Json
  status        ReportExportJobStatus @default(PENDING)
  fileReference String?               @map("file_reference")
  rowCount      Int?                  @map("row_count")
  errorMessage  String?               @map("error_message") @db.Text
  createdAt     DateTime              @default(now()) @map("created_at")
  completedAt   DateTime?             @map("completed_at")

  institution Institution @relation(fields: [institutionId], references: [id])
  requester   User        @relation(fields: [requestedBy], references: [id])

  @@map("report_export_jobs")
}

enum JobRunStatus {
  RUNNING
  RETRY_PENDING
  SUCCESS
  FAILED
}

enum JobTrigger {
  SCHEDULE
  MANUAL
}

/// Reusable scheduled-job infrastructure (docs/TODO.md): one row per logical
/// job execution — a cron tick, a manual "run now", or a scheduled report
/// subscription firing — updated in place across its retry attempts, so it
/// doubles as the delivery history. `params` is what the handler needs to run
/// (and is narrowed on a partial failure so a retry redoes only the failed
/// part); `institutionId` is null for a system-wide job. Deliberately no
/// foreign keys: a history row should outlive (and never block deleting) the
/// institution or user it mentions.
model JobRun {
  id            Int          @id @default(autoincrement())
  institutionId Int?         @map("institution_id")
  jobType       String       @map("job_type")
  trigger       JobTrigger
  requestedBy   Int?         @map("requested_by")
  status        JobRunStatus
  attempt       Int          @default(1)
  maxAttempts   Int          @default(1) @map("max_attempts")
  params        Json?
  result        Json?
  errorMessage  String?      @map("error_message") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  startedAt     DateTime?    @map("started_at")
  finishedAt    DateTime?    @map("finished_at")
  nextAttemptAt DateTime?    @map("next_attempt_at")

  @@index([institutionId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("job_runs")
}

enum EmailPurpose {
  TEST
  INVITATION
  PASSWORD_RESET
  GRADUATE_SURVEY
  EMPLOYER_SURVEY
  STAFF_NOTIFICATION
}

enum EmailDeliveryStatus {
  SENT
  FAILED
}

/// Email delivery (docs/TODO.md): one row per email actually attempted through
/// the SMTP transport — nothing is written when email isn't configured, since
/// nothing was attempted. The body is deliberately not stored (it can carry a
/// single-use link); a failed survey email is re-sent by re-running the
/// campaign, which finds the latest FAILED row for each survey. No foreign
/// keys, like JobRun: a delivery record should outlive what it mentions.
model EmailDelivery {
  id                Int                 @id @default(autoincrement())
  institutionId     Int                 @map("institution_id")
  purpose           EmailPurpose
  toAddress         String              @map("to_address")
  subject           String
  status            EmailDeliveryStatus
  errorMessage      String?             @map("error_message") @db.Text
  relatedEntityType String?             @map("related_entity_type")
  relatedEntityId   Int?                @map("related_entity_id")
